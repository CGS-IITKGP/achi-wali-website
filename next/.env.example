# # Frontend environment variables
# NEXT_PUBLIC_API_BASE_URL = "<YOUR_API_BASE_URL>"
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID = "<YOUR_GOOGLE_OAUTH_CLIENT_ID>"
# NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI = "<YOUR_GOOGLE_OAUTH_REDIRECT_URI>"

# # Backend configuration
# BACKEND_LOG_LEVEL = "<DEBUG/INFO/WARN/ERROR>"
# BACKEND_ENV = "<dev/staging/prod>"
# BACKEND_HTTPS_ENFORCED = "<true/false>"
# BACKEND_JWT_SECRET_KEY = "<YOUR_JWT_SECRET_KEY>"

# # MongoDB connection
# BACKEND_MONGODB_CONNECTION_URI = "<YOUR_MONGODB_CONNECTION_URI>"

# # SMTP / Email configuration (not in use currently, but required as empty strings)
# BACKEND_SMTP_HOST = ""
# BACKEND_SMTP_PORT = ""
# BACKEND_SMTP_FROM = ""
# BACKEND_SMTP_USERNAME = ""
# BACKEND_SMTP_PASSWORD = ""

# # Cloudinary configuration
# BACKEND_CLOUDINARY_CLOUD_NAME = "<YOUR_CLOUDINARY_CLOUD_NAME>"
# BACKEND_CLOUDINARY_API_KEY = "<YOUR_CLOUDINARY_API_KEY>"
# BACKEND_CLOUDINARY_API_SECRET = "<YOUR_CLOUDINARY_API_SECRET>"

# # Backend Google OAuth
# BACKEND_GOOGLE_OAUTH_CLIENT_ID = "<YOUR_GOOGLE_OAUTH_CLIENT_ID>"
# BACKEND_GOOGLE_OAUTH_CLIENT_SECRET = "<YOUR_GOOGLE_OAUTH_CLIENT_SECRET>"
# BACKEND_GOOGLE_OAUTH_REDIRECT_URI = "<YOUR_GOOGLE_OAUTH_REDIRECT_URI>"
# BACKEND_GOOGLE_OAUTH_SUCCESSFUL_REDIRECT = "<YOUR_SUCCESSFUL_REDIRECT_URL>"

# # Game / Leaderboard integration
# GAME_SECRET = "<YOUR_GAME_SECRET>"


# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=dummy-google-client-id
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Backend
BACKEND_LOG_LEVEL=DEBUG
BACKEND_ENV=dev
BACKEND_HTTPS_ENFORCED=false
BACKEND_JWT_SECRET_KEY=dummy-jwt-secret-for-local-build-testing-123456789

# MongoDB
BACKEND_MONGODB_CONNECTION_URI=mongodb://localhost:27017/test

# SMTP - required by validation, but not actually used
BACKEND_SMTP_HOST=dummy.smtp.local
BACKEND_SMTP_PORT=587
BACKEND_SMTP_FROM=test@example.com
BACKEND_SMTP_USERNAME=dummy
BACKEND_SMTP_PASSWORD=dummy

# Cloudinary
BACKEND_CLOUDINARY_CLOUD_NAME=dummy-cloud
BACKEND_CLOUDINARY_API_KEY=dummy-api-key
BACKEND_CLOUDINARY_API_SECRET=dummy-api-secret

# Backend Google OAuth
BACKEND_GOOGLE_OAUTH_CLIENT_ID=dummy-google-client-id
BACKEND_GOOGLE_OAUTH_CLIENT_SECRET=dummy-google-client-secret
BACKEND_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
BACKEND_GOOGLE_OAUTH_SUCCESSFUL_REDIRECT=http://localhost:3000

# Game
GAME_SECRET=dummy-game-secret